{
  "name": "sportswire-web",
  "version": "1.0.0",
  "private": true,
  "description": "SportsWire sports stats, trivia, and social competition web app.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node src/server.js",
    "dev:client": "vite",
    "test": "node --test src/services/**/*.test.js src/client/**/*.test.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
